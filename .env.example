# ============================================================
# Novelis Core Configuration
# ============================================================

# Primary LLM Provider: Google Gemini API (Default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Secondary / Fallback LLM Provider (OpenAI Compatible)
# Compatible with: OpenRouter, Groq, DeepSeek, or local Ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding & Reranker Configuration
# Options: "local" (FastEmbed ONNX CPU-friendly) or "remote" (Colab/Kaggle GPU)
EMBEDDING_MODE=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Remote GPU Worker URL (Required only if EMBEDDING_MODE=remote)
# Example: https://your-colab-worker-tunnel.trycloudflare.com
REMOTE_WORKER_URL=

# Data & Persistence Directories
DATA_DIR=./data
